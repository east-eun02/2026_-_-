# 관찰 기록 화면 + 로봇 제어 버튼. 노트북이 켜져 있으면 항상 떠 있고, 로봇(plant-onboard)은 이 화면에서 켠다.
# 설치·켜고 끄기는 install_onboard_service.sh 참고
[Unit]
Description=Plant observer review screen and robot control panel (http://<laptop IP>:8080)
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=%h/plant_ws/src/plant_observer_bringup/service/review_start.sh
Environment=ROS_DOMAIN_ID=7
Environment=PYTHONUNBUFFERED=1
Environment=RCUTILS_COLORIZED_OUTPUT=0
# 노트북마다 다른 설정 (저장소에 없음). 예: PLANT_ROUTE=demo_real3_artificial  → 순찰 버튼이 도는 루트
EnvironmentFile=-%h/.config/plant_observer/panel.env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
