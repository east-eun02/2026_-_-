<?xml version="1.0"?>
<!--
  Gazebo Harmonic 전용 설정: 바퀴 구동, 관절 상태, 가상 라이다·카메라.
  토픽 이름은 실물과 같게 맞춘다: /cmd_vel, /odom, /scan, /camera/image_raw
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <!-- 차동 구동: /cmd_vel 입력, /odom + odom→base_footprint TF 출력 -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_linear_velocity>0.3</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- RPLIDAR C1: 실측과 같게 10Hz · 한 바퀴 720점 · 0.05~12m -->
  <gazebo reference="laser">
    <sensor name="c1_lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- U20CAM: 광각(가로 약 103°). 가상에서는 부담을 줄이려 1280x720 · 15Hz -->
  <gazebo reference="camera_link">
    <sensor name="u20cam" type="camera">
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>${camera_hfov}</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
